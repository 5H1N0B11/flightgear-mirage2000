<?xml version="1.0" encoding="utf-8"?>

<PropertyList>

	<settings>
		<minimums type="int"> 200 </minimums>
		<target-roll-deg type="double"> 0 </target-roll-deg>
		<target-pitch-deg type="double"> 0 </target-pitch-deg>
		<vertical-speed-fpm type="double"> 0 </vertical-speed-fpm>
		<target-climb-rate-fpm type="double"> 500 </target-climb-rate-fpm> <!-- max |vertical speed| the ALT lock will command; raised by m2000-5_autopilot.nas for ALT-selected capture -->
		<nav-source type="string">NAV1</nav-source>
		<bank-limit type="int"> 47 </bank-limit>
		<target-speed-kt type="int"> 350 </target-speed-kt>
		<target-speed-mach type="double"> 0.40 </target-speed-mach>
		<target-altitude-ft type="int">4000</target-altitude-ft> <!-- what will be followed by the autopilot-->
		<selected-altitude-ft type="int">4000</selected-altitude-ft> <!-- what is preselected by the pilot and might be placed into target-alt -->
		<changeover type="bool">false</changeover>
		<heading-bug-deg type="int">0</heading-bug-deg>
		<tf-mode type="int">8</tf-mode> <!-- Larger values give smoother results -->
	</settings>

	<locks>
		<heading>ROLL</heading>
		<heading-arm type="string"></heading-arm>
		<altitude>PTCH</altitude>
		<altitude-arm type="string"></altitude-arm>
		<AP-status type="string"></AP-status>
		<FD-status type="bool">true</FD-status>
		<yaw-damper type="bool">false</yaw-damper>
		<m-trim type="bool">false</m-trim>
	</locks>

	<internal>
		<selected-crs type="int"> 0 </selected-crs>
		<nav-distance type="double"> 0 </nav-distance>
		<nav-type type="string"></nav-type>
		<nav-id type="string"></nav-id>
		<course-deflection type="double"> 0.0 </course-deflection>
		<gs-valid type="bool">false</gs-valid>
		<gs-deflection type="double"> 0.0 </gs-deflection>
		<in-range type="bool">false</in-range>
		<gs-in-range type="bool">false</gs-in-range>

		<aileron-pid>
			<kp-low type="double">0.31</kp-low>
			<kp-high type="double">0.128</kp-high>
			<ki-low type="double">0.98</ki-low>
			<ki-high type="double">2.12</ki-high>
			<kd-low type="double">0.0654</kd-low>
			<kd-high type="double">0.00515</kd-high>
		</aileron-pid>

		<target-pitch-pid>
			<kp-low type="double">0.7</kp-low>
			<kp-high type="double">0.16</kp-high>
			<ki-low type="double">4.34</ki-low>
			<ki-high type="double">1.984</ki-high>
			<kd-low type="double">0.0753</kd-low>
			<kd-high type="double">0.00861</kd-high>
		</target-pitch-pid>

		<vertical-speed-pid>
			<kp type="double">0.034</kp>
			<ki type="double">0.164</ki>
			<kd type="double">0.00470</kd>
		</vertical-speed-pid>
	</internal>

	<buttons> <!-- Animations for autopilot button faces visibility -->
		<pa-att-armed type="bool">false</pa-att-armed>
		<pa-att-standby type="bool">false</pa-att-standby>

		<pa-alt-armed type="bool">false</pa-alt-armed>
		<pa-alt-standby type="bool">false</pa-alt-standby>

		<pa-aff-armed type="bool">false</pa-aff-armed>
		<pa-aff-standby type="bool">false</pa-aff-standby>

		<pa-app-g-armed type="bool">false</pa-app-g-armed>
		<pa-app-g-standby type="bool">false</pa-app-g-standby>
		<pa-app-l-armed type="bool">false</pa-app-l-armed>
		<pa-app-l-standby type="bool">false</pa-app-l-standby>
	</buttons>

</PropertyList>
