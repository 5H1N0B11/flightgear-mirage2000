	<!--
	================================================================================
	TOOLTIPS
	================================================================================
	-->
	<animation>
		<type>pick</type>
		<object-name>ap.pa-att-button</object-name>
		<object-name>ap.pa-att-armed-off</object-name>
		<object-name>ap.pa-att-armed-on</object-name>
		<object-name>ap.pa-att-standby-off</object-name>
		<object-name>ap.pa-att-standby-on</object-name>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>att_autopilot</tooltip-id>
				<label>Engage / Disengage Autopilot</label>
			</binding>
		</hovered>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>ap.pa-alt-button</object-name>
		<object-name>ap.pa-alt-armed-off</object-name>
		<object-name>ap.pa-alt-armed-on</object-name>
		<object-name>ap.pa-alt-standby-off</object-name>
		<object-name>ap.pa-alt-standby-on</object-name>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>alt_autopilot</tooltip-id>
				<label>Altitude Hold</label>
			</binding>
		</hovered>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>ap.pa-aff-button</object-name>
		<object-name>ap.pa-aff-armed-off</object-name>
		<object-name>ap.pa-aff-armed-on</object-name>
		<object-name>ap.pa-aff-standby-off</object-name>
		<object-name>ap.pa-aff-standby-on</object-name>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>aff_autopilot</tooltip-id>
				<label>Selected Altitude Hold</label>
			</binding>
		</hovered>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>ap.pa-empty-button</object-name>
		<object-name>ap.pa-empty-armed-off</object-name>
		<object-name>ap.pa-empty-standby-off</object-name>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>empty_autopilot</tooltip-id>
				<label>Not in Use</label>
			</binding>
		</hovered>
	</animation>

	<animation>
		<type>pick</type>
		<object-name>ap.pa-app-button</object-name>
		<object-name>ap.pa-app-g-armed-off</object-name>
		<object-name>ap.pa-app-g-armed-on</object-name>
		<object-name>ap.pa-app-g-standby-off</object-name>
		<object-name>ap.pa-app-g-standby-on</object-name>
		<object-name>ap.pa-app-l-armed-off</object-name>
		<object-name>ap.pa-app-l-armed-on</object-name>
		<object-name>ap.pa-app-l-standby-off</object-name>
		<object-name>ap.pa-app-l-standby-on</object-name>
		<hovered>
			<binding>
				<command>set-tooltip</command>
				<tooltip-id>app_autopilot</tooltip-id>
				<label>Approach (ILS)</label>
			</binding>
		</hovered>
	</animation>

	<!--
	================================================================================
	TEXT OSG
	================================================================================
	-->
	<text>
		<name>ap.textosg</name>
		<type type="string">literal</type>
		<text type="string">Autopilot</text>
		<draw-text type="bool">true</draw-text>
		<font>Helvetica.txf</font>
		<character-size type="double">0.016</character-size>
		<character-aspect-ratio type="double">1.0</character-aspect-ratio>
		<axis-alignment>yz-plane</axis-alignment>
		<max-height>0.06</max-height>
		<max-width>0.08</max-width>
		<font-resolution>
		<width type="int">64</width>
		<height type="int">64</height>
		</font-resolution>
		<alignment>center-center</alignment>
		<offsets>
		<x-m>-3.48</x-m>
		<y-m>-.2</y-m>
		<z-m>-.2</z-m>
		</offsets>
	</text>

	<animation>
		<type>material</type>
		<object-name>ap.textosg</object-name>
		<emission>
		<red>1</red>
		<green>0.2</green>
		<blue>0.2</blue>
		</emission>
	</animation>
	<animation>
		<type>select</type>
		<object-name>ap.textosg</object-name>
		<condition>
		<property>sim/panel-hotspots</property>
		</condition>
	</animation>

</PropertyList>
