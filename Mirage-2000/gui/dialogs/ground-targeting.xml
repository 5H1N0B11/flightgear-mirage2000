<?xml version="1.0" encoding="utf-8"?>

<PropertyList>
	<name>ground-targeting</name>
	<modal type="bool">false</modal>
	<layout>vbox</layout>
	<!--  <width>800</width>
	<height>345</height>-->

	<group>
		<layout>hbox</layout>
		<empty>
			<stretch>1</stretch>
		</empty>
		<text>
			<label>Ground Targeting</label>
		</text>

		<empty>
			<stretch>1</stretch>
		</empty>

		<button>
			<pref-width>16</pref-width>
			<pref-height>16</pref-height>
			<legend></legend>

			<default>1</default>
			<keynum>27</keynum>
			<border>2</border>
			<binding>
				<command>dialog-close</command>
			</binding>
			<binding>
				<command>dialog-apply</command>
			</binding>
		</button>
	</group>

	<hrule />

	<button>
		<legend>Acquire lon/lat from Previous Click on Ground</legend>
		<enable>
			<equals>
				<property>payload/armament/station/id-6-set</property>
				<value>PDLCT</value>
			</equals>
		</enable>
		<binding>
			<command>nasal</command>
			<script>groundTargeting.acquireClickedCoordinates();</script>
		</binding>
	</button>

	<text><label>Spotted or Typed Primary Coordinates</label></text>

	<input>
		<width>75</width>
		<height>25</height>
		<label>Lon</label>
		<property>/sim/dialog/groundTargeting/primary-longitude-deg</property>
	</input>

	<input>
		<width>75</width>
		<height>25</height>
		<label>Lat</label>
		<property>/sim/dialog/groundTargeting/primary-latitude-deg</property>
	</input>

	<hrule />

	<text><label>Secondary Coordinates</label></text>

	<input>
		<width>75</width>
		<height>25</height>
		<label>Lon</label>
		<property>/sim/dialog/groundTargeting/secondary-longitude-deg</property>
	</input>

	<input>
		<width>75</width>
		<height>25</height>
		<label>Lat</label>
		<property>/sim/dialog/groundTargeting/secondary-latitude-deg</property>
	</input>

	<button>
		<legend>Swap coordinates</legend>
		<binding>
			<command>dialog-apply</command>
		</binding>
		<binding>
			<command>nasal</command>
			<script>groundTargeting.swapCoordinates();</script>
		</binding>
	</button>

	<hrule />

	<button>
		<legend>Create/Update Spotted Target from Primary Coords</legend>
		<binding>
			<command>dialog-apply</command>
		</binding>
		<binding>
			<command>nasal</command>
			<script>groundTargeting.createSpottedTarget()</script>
		</binding>
	</button>

	<button>
		<legend>Delete Spotted Target</legend>
		<binding>
			<command>dialog-apply</command>
		</binding>
		<binding>
			<command>nasal</command>
			<script>groundTargeting.deleteSpottedTarget()</script>
		</binding>
	</button>

	<hrule />

	<button>
		<legend>Designate Spotted Target as Ready for Engagement</legend>
		<binding>
			<command>dialog-apply</command>
		</binding>
		<binding>
			<command>nasal</command>
			<script>groundTargeting.designateSpottedTarget()</script>
		</binding>
	</button>

	<button>
		<legend>Focus FLIR on Spotted Target</legend>
		<binding>
			<command>dialog-apply</command>
		</binding>
		<binding>
			<command>nasal</command>
			<script>groundTargeting.focusFLIROnSpottedTarget()</script>
		</binding>
	</button>

	<hrule />

	<group>
		<layout>table</layout>
		<halign>center</halign>
		<text>
			<row>0</row>
			<col>0</col>
			<label>A/G Falling time</label>
		</text>
		<text>
			<row>0</row>
			<col>1</col>
			<live>true</live>
			<property>/sim/dialog/groundTargeting/time-to-target</property>
		</text>
	</group>

	<slider>
		<name>TTT</name>
		<property>/sim/dialog/groundTargeting/time-to-target</property>
		<live>1</live>
		<min>10</min>
		<max>30</max>
		<step>5</step>
		<binding>
			<command>dialog-apply</command>
		</binding>
		<binding>
			<command>nasal</command>
			<script>
			gui.popupTip(sprintf("Falling time : %d", getprop("/sim/dialog/groundTargeting/time-to-target")));
			</script>
		</binding>
	</slider>

</PropertyList>
